{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gloves-proj",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gloves-db",
      "database_id": "60f7ed82-d465-4a51-976d-ddfdde310952"
    }
  ]
}
